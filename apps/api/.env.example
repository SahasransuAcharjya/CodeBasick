# CodeBasick Backend Environment Configuration
PROJECT_NAME="CodeBasick API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"

# OneCompiler Code Execution API
# Obtain from OneCompiler API console (https://onecompiler.com/api) or RapidAPI
ONECOMPILER_API_KEY=""
ONECOMPILER_BASE_URL="https://api.onecompiler.com/v1/run"
ONECOMPILER_TIMEOUT_SECONDS=15.0
# Optional: Set host header if using RapidAPI proxy (e.g. "onecompiler-apis.p.rapidapi.com")
# ONECOMPILER_HOST_HEADER=""

# Google Gemini AI Configuration
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_SECONDS=25.0

# MongoDB Atlas Persistent Database Configuration (Phase 7B)
# Standard connection string format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="codebasick"

# Authentication & Security Configuration (Phase 8 & 8.1)
# Generate a strong 256-bit random key for production (e.g. openssl rand -hex 32)
# Min length: 32 characters. In production, default dev key is strictly rejected.
AUTH_SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-bytes"
AUTH_ALGORITHM="HS256"
AUTH_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME="cb_auth_token"
# In production (ENVIRONMENT="production"), AUTH_COOKIE_SECURE must be true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE="lax"

# In-Memory Rate Limiting Settings (Per worker instance)
AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=10
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=5

# Google OAuth 2.0 / OpenID Connect credentials
# Obtain from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
